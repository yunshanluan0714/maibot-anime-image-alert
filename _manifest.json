{
  "manifest_version": 2,
  "id": "github.yunshanluan0714.anime-image-alert",
  "version": "1.4.0",
  "plugin_type": "media",
  "name": "二次元/COS图片提醒",
  "description": "向主脑暴露以图搜图出处工具并联动白名单群美图提醒：群友问出处时先搜图再答，主脑已回复时智能跳过或顺口衔接补出处，并在未覆盖时以原生 @ 和引用提醒指定用户。",
  "author": {
    "name": "yunshanluan0714",
    "url": "https://github.com/yunshanluan0714"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/yunshanluan0714/maibot-anime-image-alert",
    "homepage": "https://github.com/yunshanluan0714/maibot-anime-image-alert",
    "documentation": "https://github.com/yunshanluan0714/maibot-anime-image-alert/blob/main/README.md",
    "issues": "https://github.com/yunshanluan0714/maibot-anime-image-alert/issues"
  },
  "host_application": {
    "min_version": "1.3.19",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.20.0",
    "max_version": "2.30.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.hybrid",
    "llm.generate",
    "database.get",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
